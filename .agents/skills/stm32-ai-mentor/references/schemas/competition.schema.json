{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "STM32 competition sidecar value types",
  "$defs": {
    "CompetitionIntake": {"type": "object", "required": ["competition_name", "adapter", "edition", "track", "deadline", "team"], "properties": {"competition_name": {"type": "string", "minLength": 1}, "adapter": {"enum": ["nuedc", "cpipc", "soc_china", "generic"]}, "edition": {"type": "string", "minLength": 1}, "track": {"type": "string", "minLength": 1}, "deadline": {"type": "string", "format": "date-time"}, "team": {"type": "object"}}},
    "RuleSet": {"type": "object", "required": ["ruleset_id", "competition_name", "adapter", "edition", "track", "source_url", "source_tier", "retrieved_at", "rule_hash", "ai_use_policy"], "properties": {"competition_name": {"type": "string"}, "adapter": {"enum": ["nuedc", "cpipc", "soc_china", "generic"]}, "edition": {"type": "string"}, "track": {"type": "string"}, "source_url": {"type": "string", "format": "uri"}, "source_tier": {"enum": ["official", "organizer_authorized", "archived_official", "secondary"]}, "retrieved_at": {"type": "string", "format": "date-time"}, "rule_hash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}, "ai_use_policy": {"enum": ["disclose", "prohibit", "unknown"]}}},
    "Citation": {"type": "object", "required": ["citation_id", "title", "url", "source_tier", "retrieved_at", "purpose"], "properties": {"citation_id": {"type": "string"}, "title": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "source_tier": {"enum": ["official", "organizer_authorized", "archived_official", "secondary"]}, "retrieved_at": {"type": "string", "format": "date-time"}, "purpose": {"enum": ["rules", "prior_art", "technical", "format"]}}},
    "AIUse": {"type": "object", "required": ["use_id", "tool", "purpose", "disclosed", "student_reviewed"], "properties": {"use_id": {"type": "string"}, "tool": {"type": "string"}, "purpose": {"type": "string"}, "disclosed": {"type": "boolean"}, "student_reviewed": {"type": "boolean"}}},
    "Deliverable": {"type": "object", "required": ["deliverable_id", "kind", "status", "ruleset_hash"], "properties": {"deliverable_id": {"type": "string"}, "kind": {"enum": ["paper", "report", "slides", "defense", "package"]}, "status": {"enum": ["outline", "draft", "draft_complete", "ready", "invalidated"]}, "ruleset_hash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}, "ruleset_id": {"type": "string"}, "citation_ids": {"type": "array", "items": {"type": "string"}}, "prior_art_citation_ids": {"type": "array", "items": {"type": "string"}}, "student_decision_ids": {"type": "array", "items": {"type": "string"}}, "raw_evidence_ids": {"type": "array", "items": {"type": "string"}}, "contribution_map": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}}, "claim_evidence": {"type": "object", "minProperties": 1}, "anonymity_checked": {"type": "boolean"}, "contains_identity": {"type": "boolean"}}, "if": {"properties": {"status": {"enum": ["draft_complete", "ready"]}}, "required": ["status"]}, "then": {"required": ["ruleset_id", "citation_ids", "prior_art_citation_ids", "student_decision_ids", "raw_evidence_ids", "contribution_map", "claim_evidence", "anonymity_checked", "contains_identity"], "properties": {"citation_ids": {"minItems": 1}, "prior_art_citation_ids": {"minItems": 1}, "student_decision_ids": {"minItems": 1}, "raw_evidence_ids": {"minItems": 1}}}}
  }
}
