{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/stm32-ai-mentor/generation-evidence.schema.json",
  "title": "Evidence",
  "description": "V2 证据；来源与 V0–V5 等级不可被提升或抹去。",
  "type": "object",
  "required": [
    "evidence_id", "kind", "summary", "verification_level", "verification_status",
    "source", "baseline_hash", "acceptance_ids", "hardware_verified", "limitations"
  ],
  "properties": {
    "evidence_id": {"type": "string", "minLength": 1},
    "kind": {"enum": [
      "authoritative_document", "document_review", "design_review", "configuration_review",
      "resource_report", "resource_map", "logic_test", "host_test", "runtime_log", "measurement",
      "acceptance_test", "hardware_observation", "hardware_measurement",
      "build_result", "build_success", "build_successful", "compile_result", "compile_success",
      "compile_successful", "link_result", "link_success", "link_successful", "flash_result",
      "flash_success", "flash_successful", "program_result", "program_success", "program_successful"
    ]},
    "summary": {"type": "string", "minLength": 1},
    "verification_level": {"enum": ["V0", "V1", "V2", "V3", "V4", "V5"]},
    "verification_status": {"enum": ["unverified", "verified", "self_reported"]},
    "source": {"enum": [
      "authoritative_document", "tool", "instrument", "mentor_observed",
      "reported_by_user", "imported_reference", "instrument_capture", "verified_hardware_tool"
    ]},
    "baseline_hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "acceptance_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "hardware_verified": {"type": "boolean"},
    "limitations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "status": {"enum": ["current", "stale"]},
    "recorded_at": {"type": "string", "minLength": 1},
    "target_signature": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "artifact_hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "raw_evidence_hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "operator": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "reproduction": {
      "type": "object", "required": ["steps", "result"],
      "properties": {
        "steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "result": {"type": "string", "minLength": 1}
      }, "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"hardware_verified": {"const": true}}, "required": ["hardware_verified"]},
      "then": {
        "required": ["target_signature", "artifact_hash", "raw_evidence_hash", "operator", "timestamp", "reproduction"],
        "properties": {
          "verification_level": {"const": "V5"},
          "verification_status": {"const": "verified"},
          "source": {"enum": ["instrument_capture", "verified_hardware_tool"]}
        }
      }
    }
  ],
  "additionalProperties": true
}
